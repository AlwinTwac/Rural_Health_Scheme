# Flask Configuration
FLASK_ENV=development
SECRET_KEY=your-secret-key-here
FLASK_DEBUG=True
JWT_SECRET_KEY=your-jwt-secret-key-here

# Database - MySQL Configuration
DATABASE_URL=mysql+pymysql://root:password@localhost/rural_health
DB_HOST=localhost
DB_PORT=3306
DB_NAME=rural_health
DB_USER=root
DB_PASSWORD=password

# Zigbee Configuration (for future implementation)
ZIGBEE_PORT=/dev/ttyUSB0
ZIGBEE_BAUDRATE=115200
ZIGBEE_CHANNEL=15
ZIGBEE_PAN_ID=0x1234

# System Configuration
HUB_LOCATION_LAT=-17.8252
HUB_LOCATION_LON=31.0335
MAX_TRAVEL_DISTANCE=30
